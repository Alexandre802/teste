# ─────────────────────────────────────────────────────────────────────────────
# MD_cortes — variáveis de ambiente
#
# Para desenvolver, copie para .env.local e preencha. A build de produção já lê
# .env.production, que está versionado com os valores do projeto.
#
# Sem as duas primeiras, o app NÃO deixa ninguém entrar: mostra a tela "Sistema
# não configurado". É de propósito — sem banco não há senha para validar, e não
# existe modo local de reserva.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────────────
# Painel do Supabase → Project Settings → API Keys.
# A chave publishable (ou anon) é pública por natureza: ela vai no JavaScript
# entregue ao celular. Quem protege os dados é a RLS do supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NUNCA coloque a service_role key aqui nem em nenhum arquivo com NEXT_PUBLIC_.
# Ela ignora a RLS inteira e o build a embutiria no JavaScript de todo mundo.

# ── Login por usuário ───────────────────────────────────────────────────────
# A tela aceita "gabriel" no lugar de "gabriel@mdcortes.app". Este é o domínio
# que o app completa quando o campo vem sem @.
NEXT_PUBLIC_LOGIN_DOMAIN=mdcortes.app

# ── Publicação em subpasta ──────────────────────────────────────────────────
# Vazio para a Vercel, que serve na raiz do domínio.
NEXT_PUBLIC_BASE_PATH=
