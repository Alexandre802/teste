# ─────────────────────────────────────────────────────────────────────────────
# MD_cortes — variáveis de ambiente
# Copie para .env.local e preencha. .env.local NÃO vai para o repositório.
#
# Sem as duas primeiras variáveis o sistema NÃO deixa ninguém entrar: mostra a
# tela "Sistema não configurado". É de propósito — sem banco não há senha para
# validar, e aceitar qualquer senha inventada seria pior que não abrir.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────────────
# Painel do Supabase → Project Settings → Data API / API Keys.
# A chave anon é pública por natureza: quem protege os dados é a RLS do
# schema.sql, não o segredo da chave.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NUNCA coloque a service_role key aqui nem em nenhum arquivo com NEXT_PUBLIC_.
# Ela ignora a RLS inteira e o build a embutiria no JavaScript entregue ao
# celular de todo mundo.

# ── Login por usuário ───────────────────────────────────────────────────────
# A tela aceita "gabriel" no lugar de "gabriel@mdcortes.app". Este é o domínio
# que o app completa quando o campo vem sem @.
NEXT_PUBLIC_LOGIN_DOMAIN=mdcortes.app

# ── Publicação em subpasta (GitHub Pages) ───────────────────────────────────
# Só preencha se o endereço final tiver uma subpasta, ex.: usuario.github.io/md-cortes
# Nesse caso: NEXT_PUBLIC_BASE_PATH=/md-cortes
NEXT_PUBLIC_BASE_PATH=

# ── Modo local (demonstração) ───────────────────────────────────────────────
# NUNCA ligue isto numa build de produção. Com ele em "1", o app aceita a senha
# que a própria pessoa definir no primeiro acesso, guardando tudo no aparelho —
# o que serve para mostrar o sistema sem servidor, e só para isso. Quem usa é a
# prévia de página única (npm run previa), que liga a variável sozinha.
NEXT_PUBLIC_PERMITIR_MODO_LOCAL=
