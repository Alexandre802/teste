# ─────────────────────────────────────────────────────────────────────────────
# MD_cortes — configuração da build de produção
#
# Estes valores são públicos por natureza: eles vão dentro do JavaScript
# entregue a todo celular que abrir o app. Quem protege os dados é a Row Level
# Security do banco (supabase/schema.sql), não o segredo da chave.
#
# A chave que NUNCA pode aparecer aqui é a service_role: ela ignora toda a RLS.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://qtxcqlzfqfckcjpeboeo.supabase.co

# Painel do Supabase → Project Settings → API Keys → "anon public" / publishable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_TWIxTBn8_aWmtlX3xnvLNA_9ZthmAiz

# Domínio que o app completa quando o campo de usuário vem sem @.
NEXT_PUBLIC_LOGIN_DOMAIN=mdcortes.app
