# ---------------------------------------------------------------------------
# Comida Caseira da Marcia Costa
# ---------------------------------------------------------------------------
# Nenhuma destas variaveis e segredo: sao dados publicos da casa, exibidos no
# proprio site. Por isso usam o prefixo NEXT_PUBLIC_. Nunca coloque chave de
# API, token ou senha em variavel NEXT_PUBLIC_ -- esse prefixo entrega o valor
# ao navegador de quem abre o site.
#
# Enquanto uma variavel estiver vazia, o site nao inventa o dado: a secao
# aparece como "Informacao a cadastrar" e o recurso que depende dela fica
# desativado, com aviso honesto na tela.

# Numero do WhatsApp que recebe os pedidos, so digitos, com DDI e DDD.
# Exemplo de formato (NAO e o numero da casa): 5512999999999
NEXT_PUBLIC_WHATSAPP=

# Perfil do Instagram, sem @.
NEXT_PUBLIC_INSTAGRAM=

# Endereco completo da cozinha, para a secao Informacoes e para a retirada.
NEXT_PUBLIC_ENDERECO=

# Chave do Google Maps Embed API, para o mapa embutido na home.
# Sem ela o site mostra o endereço e um botão que abre o Google Maps, em vez de
# um iframe que carregaria uma vez e depois quebraria.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Link do perfil da casa no Google, para o cliente avaliar.
# Vazio = o botão "Avaliar no Google" não aparece.
NEXT_PUBLIC_GOOGLE_AVALIACOES=

# Links de marketplace, se a casa tiver.
NEXT_PUBLIC_INSTADELIVERY=
NEXT_PUBLIC_IFOOD=

# URL publica do site, usada em Open Graph, sitemap e robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Fluxo de caixa (área administrativa)
# ---------------------------------------------------------------------------
# Sem estas duas variáveis o painel não abre: /admin mostra a tela que explica
# o que falta configurar, e o site de pedidos continua funcionando como antes,
# só sem registrar o pedido no caixa.
#
# URL e chave anônima são públicas por natureza (vão para o navegador de
# qualquer jeito); quem protege os dados é a RLS do banco.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SEGREDO. Usada só pelo script scripts/sincronizar-produtos.mjs, que roda na
# sua máquina. Ela IGNORA a RLS: nunca coloque em variável NEXT_PUBLIC_, nunca
# em arquivo versionado, e nunca no ambiente do navegador.
SUPABASE_SERVICE_ROLE_KEY=
