# ---------------------------------------------------------------------------
# Comida Caseira da Marcia Costa
# ---------------------------------------------------------------------------
# Nenhuma destas variaveis e segredo: sao dados publicos da casa, exibidos no
# proprio site. Por isso usam o prefixo NEXT_PUBLIC_. Nunca coloque chave de
# API, token ou senha em variavel NEXT_PUBLIC_ -- esse prefixo entrega o valor
# ao navegador de quem abre o site.
#
# Enquanto uma variavel estiver vazia, o site nao inventa o dado: a secao
# aparece como "Informacao a cadastrar" e o recurso que depende dela fica
# desativado, com aviso honesto na tela.

# Numero do WhatsApp que recebe os pedidos, so digitos, com DDI e DDD.
# Exemplo de formato (NAO e o numero da casa): 5512999999999
NEXT_PUBLIC_WHATSAPP=

# Perfil do Instagram, sem @.
NEXT_PUBLIC_INSTAGRAM=

# Endereco completo da cozinha, para a secao Informacoes e para a retirada.
NEXT_PUBLIC_ENDERECO=

# Links de marketplace, se a casa tiver.
NEXT_PUBLIC_INSTADELIVERY=
NEXT_PUBLIC_IFOOD=

# URL publica do site, usada em Open Graph, sitemap e robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
