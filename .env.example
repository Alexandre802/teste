# ─────────────────────────────────────────────────────────────────────────────
# Casa de Ração Bandeira Branca — variáveis de ambiente
# Copie para .env.local e preencha. .env.local NÃO vai para o repositório.
#
# O site funciona inteiro sem nenhuma destas: o pedido fecha pelo WhatsApp da
# casa, que não depende de chave nenhuma. O que estas variáveis destravam é o
# login de cliente.
# ─────────────────────────────────────────────────────────────────────────────

# Domínio final. Entra no canonical, no sitemap e no Open Graph.
NEXT_PUBLIC_SITE_URL=https://casaderacaobandeirabranca.com.br

# ── Login (Auth.js) ─────────────────────────────────────────────────────────
# Obrigatório para qualquer login funcionar. Gere um com:
#   npx auth secret
AUTH_SECRET=

# Entrar com Google
# https://console.cloud.google.com → APIs e Serviços → Credenciais
#   → Criar credenciais → ID do cliente OAuth → Aplicativo da Web
# Em "URIs de redirecionamento autorizados", cadastre:
#   https://SEU-DOMINIO/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google   (para desenvolver)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Entrar com Facebook
# https://developers.facebook.com → Meus Apps → Criar app → Login do Facebook
# Em "URIs de redirecionamento do OAuth válidos", cadastre:
#   https://SEU-DOMINIO/api/auth/callback/facebook
# O Facebook exige HTTPS: em desenvolvimento use um túnel (ngrok, cloudflared).
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Sem as chaves acima, o botão daquele provedor simplesmente não aparece na
# tela de login — botão que existe é botão que funciona.
#
# O login por e-mail e senha precisa de um lugar para guardar a conta: ligue o
# seu banco em lib/usuarios.ts (o hash de senha já está pronto lá).
