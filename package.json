{
  "name": "consultech-remotion-reel",
  "version": "1.0.0",
  "description": "Vídeo vertical 1080x1920 (Reels/TikTok/Stories) da ConsulTech em Remotion",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts ConsulTechReel out/consultech-reel.mp4",
    "render:fast": "remotion render src/index.ts ConsulTechReel out/preview.mp4 --scale=0.5",
    "still": "remotion still src/index.ts ConsulTechReel out/still.png",
    "sfx": "python3 tools/gen_sfx.py",
    "typecheck": "tsc --noEmit",
    "analyze": "node tools/analyze-audio.mjs public/audio/narration.mp3"
  },
