# =====================================================================
# MD_agenda — variáveis de ambiente
#
# Copie para .env.local e preencha. Nenhum valor real entra neste
# arquivo, que é versionado.
#
# Regra que não tem exceção: segredo nunca em variável NEXT_PUBLIC_*.
# Esse prefixo entrega o valor ao navegador.
# =====================================================================

# --- Supabase (obrigatório em produção) ------------------------------
# Painel do Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de service role. SOMENTE servidor. Sem prefixo NEXT_PUBLIC.
# Quem tem esta chave ignora a RLS: nunca a exponha no navegador,
# em log ou em repositório.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ------------------------------------------------------------
# URL pública, usada em canonical, sitemap, robots e Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- WhatsApp --------------------------------------------------------
# Número que recebe os pedidos, formato internacional só com dígitos
# (ex.: 5512999999999). É o caminho garantido: o link wa.me funciona
# sem nenhuma credencial. Também pode ser definido pelo painel, em
# /admin/configuracoes — o painel tem precedência.
MAICON_WHATSAPP_NUMBER=

# Cloud API do WhatsApp — extra. Sem estas variáveis o sistema continua
# funcionando pelo wa.me; nada é simulado.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Banco local (desenvolvimento e testes) --------------------------
# Liga um banco em memória para rodar sem Supabase. Só tem efeito
# quando NÃO há Supabase configurado, e a interface avisa na tela que
# os dados não são permanentes. Deixe vazio em produção.
MD_AGENDA_LOCAL_STORE=
# Token da rota de preparo de cenário (/api/local/seed), usada pela
# suíte automatizada. Sem token, a rota recusa tudo.
MD_AGENDA_LOCAL_STORE_TOKEN=
# Credenciais do painel no modo local. Em produção quem manda é o
# Supabase Auth e estas variáveis são ignoradas.
MD_AGENDA_LOCAL_ADMIN_EMAIL=
MD_AGENDA_LOCAL_ADMIN_PASSWORD=
MD_AGENDA_LOCAL_ADMIN_SECRET=
