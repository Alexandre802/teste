# MD Cortes Store — variáveis de ambiente
#
# Copie para .env.local (que NÃO vai para o Git) e preencha.
# Nada de chave dentro de arquivo versionado.

# ------------------------------------------------------------------ Supabase
# Painel do Supabase > Project Settings > API.
# A chave "anon" é pública de propósito: quem protege os dados é o RLS
# (supabase/migrations/0002_policies.sql), não o segredo da chave.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço: ignora o RLS. Só no servidor, só para a rota que dispara
# os lembretes. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------------- lembrete por push
# Opcional. Sem estas chaves o lembrete continua funcionando com o app aberto;
# com elas, ele chega também com o app fechado.
#
# Para gerar o par:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@mdcortesstore.com.br

# Protege /api/push/dispatch de ser chamada por qualquer um.
# O Vercel Cron já é reconhecido pelo cabeçalho próprio; este segredo cobre
# qualquer outro agendador.
CRON_SECRET=
